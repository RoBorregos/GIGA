<?xml version="1.0" encoding="utf-8"?>
<robot name="frida_gripper">

  <link name="gripper">
    <inertial>
      <origin xyz="0.00033783 -0.0065249 0.0057345" rpy="0 0 0" />
      <mass value="0.43538" />
      <inertia ixx="0.00028883" ixy="-1.3378E-06" ixz="-7.8684E-07"
               iyy="0.0016861" iyz="-7.2811E-06" izz="0.0015525" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/gripper.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/gripper.STL" />
      </geometry>
    </collision>
  </link>

  <link name="right_finger">
    <inertial>
      <origin xyz="-0.0042467 -4.6842E-05 0.048292" rpy="0 0 0" />
      <mass value="0.1028" />
      <inertia ixx="8.1099E-05" ixy="3.8202E-08" ixz="1.9384E-06"
               iyy="7.2688E-05" iyz="-2.3121E-07" izz="1.8782E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/right_finger.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/right_finger.STL" />
      </geometry>
    </collision>
  </link>

  <link name="left_finger">
    <inertial>
      <origin xyz="0.0042467 4.6842E-05 0.048292" rpy="0 0 0" />
      <mass value="0.1028" />
      <inertia ixx="8.1099E-05" ixy="3.8202E-08" ixz="-1.9384E-06"
               iyy="7.2688E-05" iyz="2.3121E-07" izz="1.8782E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/left_finger.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/left_finger.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Same prismatic pair as the xacro's fixed_joints=false branch.
       Limits/axes/origins copied verbatim: 0-0.056m stroke. Note q=0 is
       the OPEN pose (fingers 0.106m apart) and q=0.056 is closed, which is
       the opposite of the Panda hand vgn/simulation.py was written for.
       Gripper.move()/read() convert between the two.

       effort is NOT from the xacro: it is the force PyBullet drives the
       joint with (btsim.Joint.set_position passes it to
       setJointMotorControl2), so it is the grip force. At the xacro's
       nominal 1N the fingers touch an object and are pushed back open by
       its weight as soon as the arm lifts, scoring every grasp a failure.
       Measured success over 240 packed-scene grasps: 1N 0.0%, 20N 10.4%,
       50N 11.7%, 150N 0.8% (at 150N the fingers punch light objects out of
       the scene). -->
  <joint name="rightfinger" type="prismatic">
    <origin xyz="-0.069 0 0.017" rpy="0 0 0" />
    <parent link="gripper" />
    <child link="right_finger" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="0.056" effort="50" velocity="8" />
    <dynamics damping="5.0" friction="0.0" />
  </joint>

  <joint name="leftfinger" type="prismatic">
    <origin xyz="0.069 0 0.017" rpy="0 0 0" />
    <parent link="gripper" />
    <child link="left_finger" />
    <axis xyz="-1 0 0" />
    <limit lower="0" upper="0.056" effort="50" velocity="8" />

    <mimic joint="rightfinger" multiplier="1" offset="0" />
  </joint>

</robot>
